# Configuration middleware-abis-logs-ingestor
# Copiez ce fichier en `.env` et adaptez les valeurs.

# Répertoire racine — seule variable de chemin requise.
# Tous les sous-dossiers sont créés automatiquement au démarrage :
#
#   ROOT_DIR/
#   ├── inputs/              ← .log.gz (ex. déposés par logspipe-relay)
#   │   └── processing_data/ ← .log à parser
#   ├── json_data/           ← JSON générés avant persistance
#   ├── archives/
#   │   ├── inputs/<YYYYMMDD>/
#   │   └── json_data/<YYYYMMDD>/
#   ├── errors/
#   ├── logs/                ← stats d'exécution
#   └── backups/             ← .gz sauvegardés après décompression

# Linux
ROOT_DIR=/opt/abis-ingestor/storage

# Windows
# ROOT_DIR=D:\abis-ingestor\storage

# Relatif au dossier du projet (défaut si ROOT_DIR absent)
# ROOT_DIR=storage

# Alias rétrocompatible (ignoré si ROOT_DIR est défini)
# STORAGE_DIR=storage

# Base de données PostgreSQL
# DB_DSN=postgresql+psycopg2://user:password@localhost:5432/abis
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abis
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=abis

# true = applique db_scripts/schema.sql au démarrage (CREATE SCHEMA / TABLE / VIEWS)
# false = aucune initialisation automatique (utiliser python db_scripts/init_db.py)
INIT_DB=false

# Retry base de données (connexion / insertions transitoires)
MAX_RETRY_DB=3
DB_RETRY_DELAY_BASE=5
DB_RETRY_DELAY_MAX=60
DB_RETRY_BACKOFF_MULTIPLIER=2

# Nettoyage (age + espace disque sur ROOT_DIR)
CLEANUP_ARCHIVES_AFTER_DAYS=30
CLEANUP_BACKUPS_AFTER_DAYS=30
CLEANUP_ERRORS_AFTER_DAYS=90
CLEANUP_LOGS_AFTER_DAYS=30
CLEANUP_JSON_DATA_AFTER_DAYS=0
DISK_SPACE_THRESHOLD_GB=10
DISK_SPACE_TARGET_GB=15
DISK_CLEANUP_INCLUDE_JSON_DATA=false
